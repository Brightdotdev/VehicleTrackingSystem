# Node modules (always install fresh in container)
node_modules
npm-debug.log
yarn-error.log
pnpm-debug.log

# Next.js build output (we'll rebuild in Docker)
.next
out

# Logs
logs
*.log

# Environment files (use Docker secrets or ENV vars instead)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS-specific junk
.DS_Store
Thumbs.db

# Editor/IDE configs
.vscode
.idea
*.swp

# Git
.git
.gitignore
.gitattributes

# Docker files that shouldn't go in the build context
Dockerfile*
docker-compose*

# Tests (unless you specifically run them in the container)
__tests__
coverage
test-results
coverage